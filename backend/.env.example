# ──────────────────────────────────────────────
# Litra King Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# ──────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000

# Environment (set to "production" on Render automatically)
NODE_ENV=development

# MongoDB connection string from MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/litraking?retryWrites=true&w=majority

# Your deployed Vercel frontend URL (no trailing slash)
# Example: https://litra-king-shoes.vercel.app
FRONTEND_URL=https://YOUR_VERCEL_URL.vercel.app

# Admin Email Notification Destination (Change anytime)
ADMIN_EMAIL=kailashsaini122006@gmail.com

# SMTP settings for automated inquiry and security alert emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Litra King Shoes Zone" <your_email@gmail.com>

# Security & 4-Digit PIN Authentication Settings
JWT_SECRET=litra_king_shoes_zone_super_secure_jwt_secret_2026
ADMIN_SECURITY_PIN=1234
ADMIN_PASSWORD=litra123
# Password Hash (Optional, generated via bcrypt.hashSync('your_password', 10))
# ADMIN_PASSWORD_HASH=$2a$10$e.g...

# ─── AI Shoe-to-Video Generation Settings ───────────────────────
# Configure at least one real AI Image-to-Video service key below,
# or configure directly in the Admin Panel UI under Settings / Video Generator.
# Supported providers: Luma AI Dream Machine, Replicate, Fal.ai, RunwayML, Stability AI
LUMA_API_KEY=your_luma_ai_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
FAL_KEY=your_fal_ai_api_key_here
RUNWAYML_API_SECRET=your_runwayml_api_secret_here
STABILITY_API_KEY=your_stability_api_key_here


