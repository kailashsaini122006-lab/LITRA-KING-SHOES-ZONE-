# ──────────────────────────────────────────────────────────────
# Litra King Backend — Environment Variables
# ⚠️  REPLACE MONGODB_URI with your real Atlas connection string!
# NEVER commit this file to Git (.gitignore में already added है)
# ──────────────────────────────────────────────────────────────

PORT=5000

# ▶ PASTE YOUR REAL MongoDB Atlas connection string below (from atlas.mongodb.com → Connect → Drivers)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/litraking

# ▶ Step 2: Your deployed Vercel frontend URL (already correct below)
FRONTEND_URL=https://litra-king-shoes-zonechomu.vercel.app

# ▶ Step 3: Admin Email Notification Destination
# Change this anytime in the future to redirect inquiries to a different email
ADMIN_EMAIL=kailashsaini122006@gmail.com

# ▶ Step 4: Email SMTP Configuration (for sending automated emails via Gmail/SMTP)
# For Gmail: Use your Gmail address and a 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kailashsaini122006@gmail.com
SMTP_PASS=mkfxdpoentmlyqdv
SMTP_FROM="Litra King Shoes Zone" <kailashsaini122006@gmail.com>

# Security & Authentication Settings (4-Digit PIN Security & Reset System)
JWT_SECRET=litra_king_shoes_zone_super_secure_jwt_secret_2026
ADMIN_SECURITY_PIN=9876
ADMIN_PASSWORD=litra123
# Optional: Pre-hashed Bcrypt Password (if set, overrides ADMIN_PASSWORD on initial seed)
# ADMIN_PASSWORD_HASH=$2a$10$YourBcryptHashHere...

# Razorpay Online Payment Settings (Razorpay Ready Structure)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# ── SMS Gateway Configuration (for sending Delivery OTPs over cellular network) ──
# Option 1: Fast2SMS (Recommended in India - Get free/paid API Key at https://www.fast2sms.com)
SMS_GATEWAY=fast2sms
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# Option 2: Twilio (International)
# SMS_GATEWAY=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Option 3: MSG91 (India DLT)
# SMS_GATEWAY=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_DLT_TE_ID=your_dlt_template_id